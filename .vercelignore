# Exclude admin/merchant management panel from Vercel deployment.
# Admin relies on a writable filesystem (public/uploads) which Vercel's
# serverless runtime does not support. Keep the code locally for dev;
# skip it in production until we migrate to Vercel Blob / object storage.
src/app/(admin)
src/app/api/admin
src/components/admin

